    "discord-bot",
    "webhook",
    "notify",
    "notification",
    "notifications",
    "alerts",
    "push-notification",
    "cli",
    "terminal",
    "nodejs",
    "zero-dependency",
    "devtools",
    "build-notifications"
  ],
