    "bin/",
    "skill/",
    "!skill/config.json"
  ],
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "antigravity",
    "agy",
    "antigravity-skill",
    "agent-skill",
    "skill",
    "discord",
    "discord-webhook",
